1) Swapping  two numbers using - third variables

#include<stdio.h>
int main()
{
int i=100, j=200, t;
printf(" befor: i=%d j=%d \n",i, j);
t=i;
i=j;
j=t;
printf(" after: i=%d j=%d \n" i,j);
return 0;
}

2) Swapping two numbers without third variables
#include<stdio.h>
int main()
{
int k=50, l=20;
printf(" before: k=%d l=%d \n", k,l);
k=k+l;
l=k-l;
k=k-l;
printf(" after: k=%d l=%d \n", k,l);
return 0;
}

