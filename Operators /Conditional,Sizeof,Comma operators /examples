// WAP to check char is uppercase or lowercase
#include<stdio.h>
int main()
{
  char ch;
printf(" Enter the char: \n");         // a
scanf("%c", &ch);
ch >=97  &&  ch <=122  ? printf(" lower case \n")  : printf(" uppercase \n");          // lower case
return 0;
}


