// sizeof()

#include<stdio.h>
int main()
{
int i;
char ch;
float f;
double d;
printf(" %ld %ld %ld \n", sizeof(int), sizeof(i), sizeof(10));         // 4 4 4
printf(" %ld %ld %ld \n", sizeof(char), sizeof(ch), sizeof('a'));      // 1 1 4 
printf(" %ld %ld %ld \n", sizeof(float), sizeof(f), sizeof(1.2f));     // 4 4 4
printf(" %ld %ld %ld \n", sizeof(double), sizeof(d), sizeof(2.3));     // 8 8 8
return 0;
}

