## 5. Print Binary of an Integer

```c
#include <stdio.h>

void binary_print(int);

int main()
{
    int num;
    printf("Enter int num:\n");
    scanf("%d", &num);
    binary_print(num);
    printf("\n");
    return 0;
}

void binary_print(int n)
{
    static int pos = 31;
    if (pos >= 0)
    {
        printf("%d", (n >> pos) & 1);
        pos--;
        binary_print(n);
    }
    else
        pos = 31;          // reset so the function can be called again
}
```

