/*
 * pointer_types_demo.c
 * Demonstrates different pointer types in C, how they differ, and
 * how they compare/interact with each other.
 *
 * Covers:
 *   1. char*  vs  int*  (size, arithmetic, dereference differences)
 *   2. const correctness:
 *        - pointer to const      (const int *p)
 *        - const pointer         (int *const p)
 *        - const pointer to const(const int *const p)
 *   3. void* (generic pointer) and casting rules
 *   4. Comparing pointers (==, <, >) and what's valid
 *   5. Pointer to pointer (int**)
 *   6. Function pointers
 *
 * Compile:  gcc -Wall -Wextra pointer_types_demo.c -o pointer_demo
 * Run:      ./pointer_demo
 */

#include <stdio.h>

/* A simple function used later for the function-pointer example */
void greet(void) {
    printf("Hello from a function pointer!\n");
}

int main(void) {

    /* -------------------------------------------------------------
     * 1. Basic pointer types: char* vs int*
     * ---------------------------------------------------------- */
    char   c  = 'A';
    int    n  = 65;
    char  *pc = &c;
    int   *pn = &n;

    printf("---- 1. char* vs int* ----\n");
    printf("sizeof(char)   = %zu, sizeof(int)   = %zu\n", sizeof(char), sizeof(int));
    printf("sizeof(char*)  = %zu, sizeof(int*)  = %zu  (pointer size is same on most systems)\n",
           sizeof(pc), sizeof(pn));
    printf("*pc = %c, *pn = %d\n", *pc, *pn);

    /* Pointer arithmetic depends on the pointed-to type's size */
    char arr_c[3] = {'x', 'y', 'z'};
    int  arr_i[3] = {10, 20, 30};
    char *pac = arr_c;
    int  *pai = arr_i;

    printf("\nPointer arithmetic (p+1 moves by sizeof(type)):\n");
    printf("pac address: %p, (pac+1) address: %p  (moves by %zu byte)\n",
           (void*)pac, (void*)(pac + 1), sizeof(char));
    printf("pai address: %p, (pai+1) address: %p  (moves by %zu bytes)\n",
           (void*)pai, (void*)(pai + 1), 
     * 2. const correctness with pointers
     * ---------------------------------------------------------- */
    printf("\n---- 2. const-qualified pointers ----\n");

    int a = 5, b = 10;

    /* (a) Pointer to const int: data can't change via p, pointer itself can */
    const int *p_to_const = &a;
    p_to_const = &b;          /* OK: pointer can be reassigned      */
    /* *p_to_const = 20; */   /* ERROR: cannot modify data through it */
    printf("pointer-to-const:      *p_to_const = %d (points to b now)\n", *p_to_const);

    /* (b) Const pointer to int: pointer itself can't change, data can */
    int *const const_ptr = &a;
    *const_ptr = 99;           /* OK: data can be modified            */
    /* const_ptr = &b; */      /* ERROR: cannot reassign the pointer  */
    printf("const-pointer:          *const_ptr = %d (a modified via it)\n", *const_ptr);

    /* (c) Const pointer to const int: neither can change */
    const int *const fully_const = &a;
    /* *fully_const = 1; */    /* ERROR */
    /* fully_const = &b; */    /* ERROR */
    printf("const-pointer-to-const: *fully_const = %d (fully locked)\n", *fully_const);

    
     * 3. void* — generic pointers
    printf("\n---- 3. void* generic pointer ----\n");
    void *vp = &n;              /* any pointer type can be assigned to void* */
    int  *back_to_int = (int*)vp;  /* must cast before dereferencing */
    printf("value via void* (after cast back to int*): %d\n", *back_to_int);
    /* printf("%d", *vp); */    /* ERROR: cannot dereference void* directly */

    /* -------------------------------------------------------------
     * 4. Comparing pointers
     * ---------------------------------------------------------- */
    printf("\n---- 4. Comparing pointers ----\n");

    int  x = 1, y = 2;
    int *px = &x;
    int *py = &y;

    /* Same-type pointer comparisons: valid and meaningful */
    printf("px == py ? %s\n", (px == py) ? "true" : "false");
    printf("px < py  ? %s  (only meaningful if they point into the same array/object)\n",
           (px < py) ? "true" : "false");

    /* Comparing pointers into the same array is well-defined */
    printf("pai < (pai+1) ? %s\n", (pai < (pai + 1)) ? "true" : "false");

    /* Comparing pointers of DIFFERENT types directly needs a cast,
     * otherwise the compiler will warn/error (incompatible pointer types) */
    if ((void*)pc == (void*)pai) {
        printf("char* and int* point to same address (cast through void*)\n");
    } else {
        printf("char* and int* point to different addresses\n");
    }

    /* NULL pointer comparison — always valid */
    int *pnull = NULL;
    printf("pnull == NULL ? %s\n", (pnull == NULL) ? "true" : "false");

    /* -------------------------------------------------------------
     * 5. Pointer to pointer (int**)
     * ---------------------------------------------------------- */
    printf("\n---- 5. Pointer to pointer ----\n");
    int   val   = 42;
    int  *pval  = &val;
    int **ppval = &pval;
    printf("val = %d, *pval = %d, **ppval = %d\n", val, *pval, **ppval);

    /* -------------------------------------------------------------
     * 6. Function pointer
     * ---------------------------------------------------------- */
    printf("\n---- 6. Function pointer ----\n");
    void (*fptr)(void) = greet;   /* fptr holds the address of greet() */
    fptr();                        /* call through the pointer          */

    return 0;
}
